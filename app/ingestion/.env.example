# Copy to .env (ignored by Git). Do not share passwords with the collector.
# Example local SSM tunnel: 13308 -> EC2 MySQL 3308.
INGEST_MYSQL_HOST=127.0.0.1
INGEST_MYSQL_PORT=13308
INGEST_MYSQL_DATABASE=career_matching
INGEST_MYSQL_USER=
INGEST_MYSQL_PASSWORD=
# Required only for a remote host without a loopback tunnel.
INGEST_MYSQL_SSL_CA=
