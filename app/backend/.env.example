# Local dialogue loads backend/.env; process environment values take precedence.
APP_MODE=local
ENABLE_LIVE_BEDROCK=false
BEDROCK_REGION=
BEDROCK_MODEL_ID=
LOCAL_JOBS_JSON=

# Local snapshot search only; never indicates current recruitment availability.
LOCAL_INCLUDE_UNVERIFIED=false

# Local optional search; default keeps MySQL. No production ES connection configured.
JOB_SEARCH_BACKEND=mysql
ELASTICSEARCH_URL=http://127.0.0.1:19200
ELASTICSEARCH_INDEX=career-jobs-local-read

# Education search is independently selectable.
TRAINING_SEARCH_BACKEND=mysql
ELASTICSEARCH_TRAINING_INDEX=career-training-local-read

# Optional admin mode. Use a distinct random token and a separate least-privilege DB account.
ADMIN_API_TOKEN=
ADMIN_MYSQL_USER=
ADMIN_MYSQL_PASSWORD=
