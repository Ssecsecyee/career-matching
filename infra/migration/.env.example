# Copy to a private .env file. Do not put AWS access keys in Git or the frontend.
AWS_PROFILE=personal-educare
AWS_REGION=ap-northeast-2
AWS_EXPECTED_ACCOUNT_ID=YOUR_12_DIGIT_DESTINATION_ACCOUNT
SOURCE_AWS_ACCOUNT_ID=954935267704
DATA_BUNDLE=C:/educare-transfer/educare-full-data.tar.gz
DATA_BUNDLE_SHA256=PASTE_THE_SEPARATELY_SHARED_RECEIPT_SHA256
AWS_MONTHLY_PLANNING_BUDGET_USD=80
# A dedicated private bucket, all public blocks ON, tag Purpose=private-migration.
MIGRATION_BUCKET=YOUR_PRIVATE_MIGRATION_BUCKET
WEB_BUCKET=YOUR_SEPARATE_FRONTEND_BUCKET

# For a restore on the NEW host, use a newly created empty database and admin
# credentials scoped to that database. Never point these at the old live host.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_DATABASE=career_matching
MYSQL_USER=YOUR_NEW_RESTORE_USER
MYSQL_PASSWORD=SET_LOCALLY_ONLY
# MYSQL_SSL_CA=/path/to/ca.pem  # Required for non-local MySQL.
ELASTICSEARCH_URL=http://127.0.0.1:19200
ELASTICSEARCH_INDEX=career-jobs-read
ELASTICSEARCH_TRAINING_INDEX=career-training-read
# Keep disabled until the original vector runtime/model has been restored.
ENABLE_TXT_VECTOR_SEARCH=false
ENABLE_ZERO_RESULT_VECTOR_FALLBACK=false

# New account resource references, not the old education account ARNs/URLs.
CHAT_SECRET_ARN=YOUR_NEW_CHAT_SECRET_ARN
MYSQL_SECRET_ARN=YOUR_NEW_DB_SECRET_ARN
JOBS_TABLE=YOUR_NEW_JOBS_TABLE
WORK_QUEUE_URL=YOUR_NEW_SQS_QUEUE_URL
# Current vector subprocess path: /opt/career/vector-pilot-20261114.
# A new .env does NOT install this directory or its pinned model.
