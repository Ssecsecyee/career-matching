{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Career matching team test: private RDS MySQL, Sonnet Lambda, S3/CloudFront. Deploy manually after cost review.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String"
    },
    "CodeKey": {
      "Type": "String"
    },
    "SchemaKey": {
      "Type": "String"
    },
    "DataKey": {
      "Type": "String"
    },
    "SchemaHash": {
      "Type": "String"
    },
    "DataHash": {
      "Type": "String"
    },
    "DbEngineVersion": {
      "Type": "String",
      "AllowedPattern": "8\\.4\\.\\d+"
    },
    "BudgetEmail": {
      "Type": "String"
    },
    "ModelId": {
      "Type": "String",
      "Default": "global.anthropic.claude-sonnet-4-6",
      "AllowedValues": [
        "global.anthropic.claude-sonnet-4-6"
      ]
    },
    "ExpectedJobs": {
      "Type": "Number",
      "MinValue": 1
    },
    "MonthlyBudgetUsd": {
      "Type": "Number",
      "MinValue": 1,
      "MaxValue": 10000
    },
    "EnableBootstrap": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    }
  },
  "Conditions": {
    "WithBootstrap": {
      "Fn::Equals": [
        {
          "Ref": "EnableBootstrap"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.82.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private database and Lambda network.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "SubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.82.1.0/24",
        "MapPublicIpOnLaunch": false,
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Two AZs required by RDS subnet group; no public routes.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "SubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.82.2.0/24",
        "MapPublicIpOnLaunch": false,
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Two AZs required by RDS subnet group; no public routes.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Routes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Local routes plus S3 gateway; no NAT gateway.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "RouteA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetA"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private subnet routing.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "RouteB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetB"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private subnet routing.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "AppSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Lambda clients",
        "VpcId": {
          "Ref": "Vpc"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Lambda clients",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "DbSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private MySQL",
        "VpcId": {
          "Ref": "Vpc"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private MySQL",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "EndpointSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private service endpoints",
        "VpcId": {
          "Ref": "Vpc"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private service endpoints",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "DbIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DbSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 3306,
        "ToPort": 3306,
        "SourceSecurityGroupId": {
          "Ref": "AppSecurity"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Only application functions reach MySQL.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "EndpointIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "EndpointSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "SourceSecurityGroupId": {
          "Ref": "AppSecurity"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "TLS to private AWS service endpoints.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "BedrockEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "VpcEndpointType": "Interface",
        "PrivateDnsEnabled": true,
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.bedrock-runtime"
        },
        "SubnetIds": [
          {
            "Ref": "SubnetA"
          },
          {
            "Ref": "SubnetB"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurity"
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private service access without NAT; interface ENIs incur hourly charges.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "SecretsEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "VpcEndpointType": "Interface",
        "PrivateDnsEnabled": true,
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.secretsmanager"
        },
        "SubnetIds": [
          {
            "Ref": "SubnetA"
          },
          {
            "Ref": "SubnetB"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "EndpointSecurity"
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private service access without NAT; interface ENIs incur hourly charges.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "S3Endpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "VpcEndpointType": "Gateway",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.s3"
        },
        "RouteTableIds": [
          {
            "Ref": "Routes"
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Bootstrap reads its fixed S3 artifacts privately.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "DbSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Career private subnets",
        "SubnetIds": [
          {
            "Ref": "SubnetA"
          },
          {
            "Ref": "SubnetB"
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private RDS subnet group.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DbParameters": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Properties": {
        "Description": "MySQL TLS required",
        "Family": "mysql8.4",
        "Parameters": {
          "require_secure_transport": "1"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Require TLS server-side as well as client identity checks.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "mysql",
        "EngineVersion": {
          "Ref": "DbEngineVersion"
        },
        "EngineLifecycleSupport": "open-source-rds-extended-support-disabled",
        "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "MultiAZ": false,
        "PubliclyAccessible": false,
        "DBName": "career_matching",
        "MasterUsername": "career_admin",
        "ManageMasterUserPassword": true,
        "DBSubnetGroupName": {
          "Ref": "DbSubnets"
        },
        "DBParameterGroupName": {
          "Ref": "DbParameters"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DbSecurity"
          }
        ],
        "BackupRetentionPeriod": 1,
        "DeletionProtection": true,
        "AutoMinorVersionUpgrade": true,
        "CopyTagsToSnapshot": true
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Small Single-AZ team-test database; fixed ongoing cost; retain data on stack deletion.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "RuntimeSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Career team-test RuntimeSecret",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true,
          "SecretStringTemplate": "{\"username\": \"career_runtime\"}",
          "GenerateStringKey": "password"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Generated secrets never copied from local .env.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AuthSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Career team-test AuthSecret",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true,
          "SecretStringTemplate": "{}",
          "GenerateStringKey": "token"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Generated secrets never copied from local .env.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
          }
        ],
        "Policies": [
          {
            "PolicyName": "AppAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "RuntimeSecret"
                    },
                    {
                      "Ref": "AuthSecret"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock:${AWS::Region}:${AWS::AccountId}:inference-profile/${ModelId}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock:*::foundation-model/anthropic.claude-sonnet-4-6"
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Function-specific data permissions; ENI permissions required by VPC Lambda.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "InspectRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
          }
        ],
        "Policies": [
          {
            "PolicyName": "AppAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "RuntimeSecret"
                    },
                    {
                      "Ref": "AuthSecret"
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Function-specific data permissions; ENI permissions required by VPC Lambda.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "BootstrapRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
          }
        ],
        "Policies": [
          {
            "PolicyName": "AppAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Database",
                        "MasterUserSecret.SecretArn"
                      ]
                    },
                    {
                      "Ref": "RuntimeSecret"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/${SchemaKey}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/${DataKey}"
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Function-specific data permissions; ENI permissions required by VPC Lambda.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      },
      "Condition": "WithBootstrap"
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.11",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "src.handlers.cloud.lambda_handler",
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "ApiRole",
            "Arn"
          ]
        },
        "MemorySize": 512,
        "Timeout": 28,
        "ReservedConcurrentExecutions": 3,
        "VpcConfig": {
          "SubnetIds": [
            {
              "Ref": "SubnetA"
            },
            {
              "Ref": "SubnetB"
            }
          ],
          "SecurityGroupIds": [
            {
              "Ref": "AppSecurity"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "MYSQL_HOST": {
              "Fn::GetAtt": [
                "Database",
                "Endpoint.Address"
              ]
            },
            "MYSQL_PORT": "3306",
            "MYSQL_DATABASE": "career_matching",
            "MYSQL_SECRET_ARN": {
              "Ref": "RuntimeSecret"
            },
            "CHAT_SECRET_ARN": {
              "Ref": "AuthSecret"
            },
            "MYSQL_SSL_CA": "/var/task/certs/rds-global.pem",
            "CHAT_RETENTION_HOURS": "24",
            "CHAT_INCLUDE_UNVERIFIED": "true",
            "CHAT_RUNTIME_ENABLED": "true",
            "ENABLE_LIVE_BEDROCK": "true",
            "MODEL_ID": {
              "Ref": "ModelId"
            },
            "BEDROCK_REGION": {
              "Ref": "AWS::Region"
            }
          }
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Packaged source only; no .env, local credentials or source snapshots.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "ApiFunctionLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${ApiFunction}"
        },
        "RetentionInDays": 7
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Short metadata-only logs; do not log request or secret bodies.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "InspectFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.11",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "src.handlers.cloud.inspect_handler",
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "InspectRole",
            "Arn"
          ]
        },
        "MemorySize": 512,
        "Timeout": 25,
        "ReservedConcurrentExecutions": 3,
        "VpcConfig": {
          "SubnetIds": [
            {
              "Ref": "SubnetA"
            },
            {
              "Ref": "SubnetB"
            }
          ],
          "SecurityGroupIds": [
            {
              "Ref": "AppSecurity"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "MYSQL_HOST": {
              "Fn::GetAtt": [
                "Database",
                "Endpoint.Address"
              ]
            },
            "MYSQL_PORT": "3306",
            "MYSQL_DATABASE": "career_matching",
            "MYSQL_SECRET_ARN": {
              "Ref": "RuntimeSecret"
            },
            "CHAT_SECRET_ARN": {
              "Ref": "AuthSecret"
            },
            "MYSQL_SSL_CA": "/var/task/certs/rds-global.pem",
            "CHAT_RETENTION_HOURS": "24",
            "CHAT_INCLUDE_UNVERIFIED": "true",
            "CHAT_RUNTIME_ENABLED": "true",
            "ENABLE_LIVE_BEDROCK": "true",
            "MODEL_ID": {
              "Ref": "ModelId"
            },
            "BEDROCK_REGION": {
              "Ref": "AWS::Region"
            }
          }
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Packaged source only; no .env, local credentials or source snapshots.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "InspectFunctionLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${InspectFunction}"
        },
        "RetentionInDays": 7
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Short metadata-only logs; do not log request or secret bodies.",
          "must": [
            "No embedded credentials; team test deployment."
          ]
        }
      }
    },
    "BootstrapFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.11",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "src.handlers.bootstrap.lambda_handler",
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "BootstrapRole",
            "Arn"
          ]
        },
        "MemorySize": 512,
        "Timeout": 300,
        "ReservedConcurrentExecutions": 1,
        "VpcConfig": {
          "SubnetIds": [
            {
              "Ref": "SubnetA"
            },
            {
              "Ref": "SubnetB"
            }
          ],
          "SecurityGroupIds": [
            {
              "Ref": "AppSecurity"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "MYSQL_HOST": {
              "Fn::GetAtt": [
                "Database",
                "Endpoint.Address"
              ]
            },
            "MYSQL_PORT": "3306",
            "MYSQL_DATABASE": "career_matching",
            "MYSQL_SECRET_ARN": {
              "Ref": "RuntimeSecret"
            },
            "MYSQL_SSL_CA": "/var/task/certs/rds-global.pem",
            "ADMIN_SECRET_ARN": {
